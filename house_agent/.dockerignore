# =============================================================================
#  .dockerignore —— 和 Dockerfile 同级（放在项目根目录），文件名就叫 .dockerignore
#  作用：docker build 时把这些目录排除掉，不进镜像。
#  最重要的就是第一段：Windows 的 .venv 在 Linux 上完全不可用，进去只会让镜像变大。
# =============================================================================

# ---------- 虚拟环境（最关键的排除项）----------
.venv/
venv/
env/
ENV/
*/.venv/
*/.venv/**

# ---------- Python 缓存与构建产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# ---------- 版本控制与编辑器 ----------
.git/
.gitignore
.idea/
.vscode/
*.swp
.DS_Store

# ---------- 本地数据与日志 ----------
*.log
logs/
*.sqlite
*.sqlite3
*.db
*.rdb

# ---------- 本地敏感配置（容器启动时用 --env-file 注入，不打进镜像）----------
.env
.env.local
.env.*.local

# ---------- 其它 ----------
node_modules/
*.tar.gz
*.zip
